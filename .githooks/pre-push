#!/bin/sh
# pre-push 钩子：推送前运行本地验证流水线（scripts/verify.sh）。
# 任何一项失败 → 拒绝推送。注册：git config core.hooksPath .githooks
# 紧急放行：git push --no-verify（本钩子被临时绕过）。

set -e

ROOT="$(git rev-parse --show-toplevel)"

echo "==> pre-push: 本地验证流水线（scripts/verify.sh）开始..."
if sh "$ROOT/scripts/verify.sh"; then
    echo "==> pre-push: 全部通过，允许推送"
    exit 0
else
    echo "==> pre-push: 验证未通过，已拒绝推送（修复后重试，或 --no-verify 临时绕过）"
    exit 1
fi
